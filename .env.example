# kt-rss - konfiguration. Kopiera till .env och anpassa.
# Alla värden har rimliga defaults; sätt minst KT_RSS_PUBLIC_URL.

# Sökväg till SQLite-databasen. I Docker: en monterad volym.
KT_RSS_DB_PATH=/data/kt.sqlite3

# Pollningsintervall i minuter. Minst 15 (hövlighet mot KT:s API).
KT_RSS_POLL_MINUTES=15

# KT:s interna JSON-API och webbplats. Ändra normalt inte.
KT_RSS_API_URL=https://api.kyrkanstidning.se/article
KT_RSS_BASE_URL=https://www.kyrkanstidning.se

# Publik bas-URL som används för länkar i feeds. Sätt till din riktiga URL.
KT_RSS_PUBLIC_URL=http://localhost:8000

# Antal artiklar att hämta per poll respektive visa per feed.
KT_RSS_MAX_FETCH=50
KT_RSS_MAX_ITEMS=50

# Antal artiklar per sida i webui:s listor (infinite scroll-batch).
KT_RSS_PAGE_SIZE=50

# Komma-separerad lista av section_tag att begränsa till. Tom = alla sektioner.
KT_RSS_SECTION_ALLOWLIST=

# Inkludera artikelbild som enclosure i feeds (true/false).
KT_RSS_INCLUDE_IMAGE_ENCLOSURE=true

# Loggnivå: DEBUG, INFO, WARNING, ERROR.
KT_RSS_LOG_LEVEL=INFO
